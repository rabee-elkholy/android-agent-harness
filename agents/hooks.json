{
  "adb-and-git-safety": {
    "enabled": true,
    "PreToolUse": [
      {
        "matcher": "run_command|view_file|read_file|grep_search|find_by_name|list_dir|invoke_subagent|define_subagent|manage_subagents|manage_task|schedule|write_to_file|write_file|replace_file_content|multi_replace_file_content|edit_file|call_mcp_tool|send_message",
        "hooks": [
          {
            "type": "command",
            "command": "python scripts/pre_tool_safety.py",
            "timeout": 15
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "invoke_subagent|send_message",
        "hooks": [
          {
            "type": "command",
            "command": "python scripts/post_tool_reconcile.py",
            "timeout": 15
          }
        ]
      }
    ]
  },
  "turn-start-reminder": {
    "enabled": true,
    "PreInvocation": [
      {
        "type": "command",
        "command": "python scripts/pre_invocation_reminder.py",
        "timeout": 5
      }
    ]
  },
  "hook-selftest": {
    "enabled": true,
    "PreInvocation": [
      {
        "type": "command",
        "command": "python scripts/ensure_hook_selftest.py",
        "timeout": 60
      }
    ]
  },
  "delivery-stop-guard": {
    "enabled": true,
    "Stop": [
      {
        "type": "command",
        "command": "python scripts/pre_tool_safety.py",
        "timeout": 15
      }
    ]
  }
}
